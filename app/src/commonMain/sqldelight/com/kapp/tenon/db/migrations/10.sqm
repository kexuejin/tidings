-- 把「消息重写不再往 FTS 索引里堆孤儿」这条修复带给**已存在的库**。
--
-- 为什么需要一次迁移：`.sq` 里的建表语句只在**新建库**时执行；3.sqm 当初建的是
-- 无条件版 `AFTER UPDATE`（任何 UPDATE 都重建一遍索引），而且用了 IF NOT EXISTS ——
-- 于是已存在的库**永远不会**换成修好的那一版。装新版本只换了代码，没换库。
-- 真机现场：真实消息 941 条，索引里却有 4,554,999 条，库长到 21 GB。
--
-- 两步：
--   1. 换成「只有正文真的变了才动索引」的触发器；
--   2. 把已经堆起来的孤儿索引重建掉（FTS5 外部内容表的标准命令 `'rebuild'`）。
--      `rebuild` 的代价与**孤儿数量**成正比：索引健康的库是毫秒级，
--      堆过的那一次要几秒到几分钟 —— 一次性，且只在升级时付。

DROP TRIGGER IF EXISTS message_after_update;

CREATE TRIGGER message_after_update AFTER UPDATE OF text ON MessageEntity
WHEN old.text IS NOT new.text
BEGIN
    INSERT INTO MessageFts(MessageFts, rowid, text) VALUES ('delete', old.rowid, old.text);
    INSERT INTO MessageFts(rowid, text) VALUES (new.rowid, new.text);
END;

-- 先把 FTS 表补到**现行形状**再重建：
-- 生产库里它一定存在（3.sqm 建的），但迁移不该假设这一点 —— 老库与迁移夹具都可能没有它，
-- 而「表不存在」会让下面那条 rebuild 直接报 no such table。`IF NOT EXISTS` 让这一步幂等。
CREATE VIRTUAL TABLE IF NOT EXISTS MessageFts USING fts5(
    text,
    content='MessageEntity',
    content_rowid='rowid',
    tokenize='trigram'
);

INSERT INTO MessageFts(MessageFts) VALUES('rebuild');


