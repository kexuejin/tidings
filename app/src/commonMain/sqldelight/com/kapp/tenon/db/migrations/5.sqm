-- PPE-1 增补 D3 / D7：`agent-workspace` 宣告台账（AgentWorkspaceEntity）与授权状态
-- （AgentGrantEntity）两张新表，让"工作区存在但还没有会话"和"宿主批没批"这两件事
-- 也跨重启留存。
--
-- 为什么必须有这个文件：SQLDelight 的版本号 = 迁移文件数 + 1，加了 `5.sqm` 之后
-- `RelayDatabase.Schema.version` 从 5 变 6；一个**已存在**的库（user_version = 5）由驱动
-- 走 `migrate(5, 6)` 跑到这里。没有它，老库上这两张表根本不存在，而新加的查询是显式点名的
-- `INSERT INTO AgentWorkspaceEntity …` —— 症状不是"少几行"，而是保存那一刻就
-- `no such table: AgentWorkspaceEntity`，被 `runCatching` 吞掉后变成
-- "收到过的工作区重启就没了、批过的授权重启又显示未申请"（与 2.sqm 记的是同一类故障）。
--
-- 幂等纪律照 `2.sqm` / `4.sqm` 的逐字理由（那两条注释解释了同一件事的两种坏法）：
-- 1. **`IF NOT EXISTS` 是刻意的。** 桌面那条手写路径（`DatabaseDriverFactory.jvm.kt`）遇到
--    `user_version = 0` 且结构已到最新的库时，会从中间某一档开始跑迁移 —— 那种库上这两张表
--    可能已经由 `Schema.create` 建好了，报 `table … already exists` 会让用户开不了 App。
-- 2. 只加表、只加索引，**不改也不删任何既有列**：迁移不要求回填，老行原样都是合法状态。
--    这两张表是新实体，老库里没有对应行 ⇒ 读回来是空 map，界面上是"沉默"（NONE），
--    正好是父稿 §3.3 要的语义。
-- 3. 与 `RelayDatabase.sq` 里的定义必须**逐列一致**：前者是"新库直接建出来的形状"，
--    这里是"老库补出来的形状"，对不上会让同一份代码在两种库上读出不同的东西。
--
-- `agent_key` 可空但不进主键（改名是同一行，理由写在 .sq 的注释里）；
-- `AgentGrantEntity.agent_key` 反过来 NOT NULL DEFAULT '' —— 空串是"整台设备"那一档的
-- **编码**，SQLite 的 NULL 不参与唯一性判定，拿它当主键成员会让同一节点攒出多条设备级授权。
CREATE TABLE IF NOT EXISTS AgentWorkspaceEntity (
    node_id TEXT NOT NULL,
    agent_key TEXT,
    -- D6 的 agent 实例身份原值；agent_key 是它的派生物（= agent_id ?? agent_kind）。
    agent_id TEXT,
    ws_id TEXT NOT NULL,
    ws_title TEXT,
    ws_path TEXT,
    agent_kind TEXT,
    -- NULL = 宿主没报 online（沉默 ≠ 离线）。
    online INTEGER,
    -- NULL = 宿主没自报会话数。
    session_count INTEGER,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (node_id, ws_id)
);

CREATE INDEX IF NOT EXISTS idx_agent_workspace_node ON AgentWorkspaceEntity(node_id);

CREATE TABLE IF NOT EXISTS AgentGrantEntity (
    node_id TEXT NOT NULL,
    agent_key TEXT NOT NULL DEFAULT '',
    scope TEXT NOT NULL,
    state TEXT NOT NULL,
    at INTEGER NOT NULL,
    PRIMARY KEY (node_id, agent_key)
);
