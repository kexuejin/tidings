-- PPE-1 §6.3 / §6.4 / §6.5 / §6.7 的四张 agent 表：让「审批处置 / 队列任务 / 执行状态 / 产物」
-- 也跨重启留存。
--
-- 为什么必须有这个文件：SQLDelight 的版本号 = 迁移文件数 + 1，加了 `2.sqm` 之后
-- `RelayDatabase.Schema.version` 从 2 变 3；一个**已存在**的库（user_version = 2）由驱动
-- 走 `migrate(2, 3)` 跑到这里。没有它，老库上没有这四张表，而新加的查询是显式点名的
-- `INSERT INTO AgentApprovalEntity …` —— 症状不是"审批少了"，而是保存那一刻就
-- `no such table: AgentApprovalEntity`，被 `runCatching` 吞掉后就变成"点完允许、重启又回来了"。
--
-- 三条纪律：
-- 1. **`IF NOT EXISTS` 是刻意的，不是凑格式。** 桌面那条手写的迁移路（`DatabaseDriverFactory.jvm.kt`）
--    遇到 `user_version = 0` 且结构已到第 2 版的库时，会从第 2 级开始跑迁移 —— 那种库上
--    这四张表可能已经由 `Schema.create` 建好了，报 `table … already exists` 会让用户开不了 App
--    （与 `1.sqm` 的 `duplicate column name: screen_json` 是同一类风险）。
-- 2. 只加表、只加索引，**不改也不删任何既有列**：迁移不能要求回填，老行原样都是合法状态。
-- 3. 这四张表与 `RelayDatabase.sq` 里的定义必须逐列一致 —— 前者是"新库直接建出来的形状"，
--    这里是"老库补出来的形状"，两者对不上会让同一份代码在两种库上读出不同的东西。
CREATE TABLE IF NOT EXISTS AgentApprovalEntity (
    node_id TEXT NOT NULL,
    approval_id TEXT NOT NULL,
    session_id TEXT NOT NULL,
    tool TEXT,
    summary TEXT,
    expires_at INTEGER NOT NULL,
    choices TEXT,
    -- NULL = 还没处置（≠ 被拒）。
    status TEXT,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (node_id, approval_id)
);

CREATE INDEX IF NOT EXISTS idx_agent_approval_session ON AgentApprovalEntity(node_id, session_id);

CREATE TABLE IF NOT EXISTS AgentTaskEntity (
    node_id TEXT NOT NULL,
    task_id TEXT NOT NULL,
    -- NULL = 「待分配到新会话」（§6.3 原文）。
    session_id TEXT,
    op TEXT NOT NULL,
    prompt TEXT,
    queued_at INTEGER NOT NULL,
    PRIMARY KEY (node_id, task_id)
);

CREATE INDEX IF NOT EXISTS idx_agent_task_session ON AgentTaskEntity(node_id, session_id);

CREATE TABLE IF NOT EXISTS AgentRunEntity (
    node_id TEXT NOT NULL,
    run_id TEXT NOT NULL,
    session_id TEXT NOT NULL,
    state TEXT NOT NULL,
    at INTEGER NOT NULL,
    note TEXT,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (node_id, run_id)
);

CREATE INDEX IF NOT EXISTS idx_agent_run_session ON AgentRunEntity(node_id, session_id);

CREATE TABLE IF NOT EXISTS AgentArtifactEntity (
    node_id TEXT NOT NULL,
    artifact_id TEXT NOT NULL,
    session_id TEXT NOT NULL,
    file_id TEXT,
    name TEXT NOT NULL,
    bytes INTEGER,
    mime TEXT,
    at INTEGER NOT NULL,
    PRIMARY KEY (node_id, artifact_id)
);

CREATE INDEX IF NOT EXISTS idx_agent_artifact_session ON AgentArtifactEntity(node_id, session_id);
