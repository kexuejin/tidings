-- 会话摘要表：让「会话列表」不必依赖「内存里有没有全部消息」。
--
-- ## 为什么需要它
--
-- RelayUiState.conversations 现在从 messages 现算：id 集合来自 messages.keys、
-- 预览/时间/排序来自 thread.lastOrNull()。分页（每会话最近 N 条）能维持这个前提，
-- 但它把「会话列表」和「消息窗口」绑在了一起 —— 只要想再省内存（比如只加载
-- 当前打开的会话），会话列表就会集体失真。
--
-- 把这两件事拆开：会话摘要进这张表（永远全量、只有几十行），消息本体按需分页。
-- 形态与茶话间一致（它也是 conversations + messages 两张表）。
--
-- ## 为什么必须回填
--
-- 空表的后果不是「少一个优化」，是**会话列表整片消失**（id 集合改由摘要表提供）。
-- 所以建表后立刻按现有消息回填：每个会话取 seq 最大的那条。
CREATE TABLE IF NOT EXISTS ConversationSummary (
    conv_id TEXT NOT NULL PRIMARY KEY,
    last_message_id TEXT,
    -- 列表预览。空正文落成 NULL（与 RelayUiState 里 text.ifBlank { file?.name } 同义；
    -- 真机上 file_json 恒为 null，所以不需要在迁移里解 JSON）。
    last_text_preview TEXT,
    last_message_at INTEGER NOT NULL,
    last_message_is_mine INTEGER NOT NULL
);

INSERT OR REPLACE INTO ConversationSummary (
    conv_id, last_message_id, last_text_preview, last_message_at, last_message_is_mine
)
SELECT m.conv_id, m.id, NULLIF(trim(m.text), ''), m.timestamp, m.mine
FROM MessageEntity m
WHERE m.seq = (SELECT MAX(x.seq) FROM MessageEntity x WHERE x.conv_id = m.conv_id);
