-- 会话可见性：AgentSessionEntity 获得 `origin` / `blank` 两列 —— DSH 自己用来决定
-- 一条会话该不该出现在工作区浏览器里的那两条判据（官方 `sessionVisible()`：
-- 子代理会话一律隐藏；空壳会话只要不是"当前会话"就隐藏）。
--
-- 为什么加列：真机上这个浮层与工作区卡片成批出现「Route this bounded MEMORY.md archive…」
-- （全是子代理会话）与成对的「未命名」（它们的空壳父会话）。110 行落库会话里 68 行是
-- DSH 自己一定不显示的。靠标题认不出来 —— 子代理会话的标题就是那条 prompt 的首行。
--
-- 为什么不能只在入库时过滤：这两键是后加的，此前落库的行 `announced=1`、没有任何撤回帧
-- 会再来碰它们，`pruneEndedSessions` 又只 prune 内存态不删库 —— 存量行必须靠**展示层**过滤清掉。
--
-- 为什么是「补建 + 重建」而不是 `ALTER TABLE … ADD COLUMN`：与 `4.sqm` / `6.sqm` 同一条纪律，理由逐字相同 ——
--  1. v1 → v6 链上任何早于本版的路径都可能碰上"表还不存在"，`ALTER` 直接 `no such table`；
--  2. 「表已是最新但 user_version=0」的桌面库重跑本文件时，`ALTER` 会撞 `duplicate column name`，
--     用户开不了 App。重建天然幂等：新列在旧形状上不存在 → 补 NULL；已经存在 → 原样搬；
--  3. 重建（`create new + INSERT…SELECT 点名列 + drop + rename`）是所有 SQLite 版本都支持的写法，
--     `DROP COLUMN` 不是（要求 ≥ 3.35，Android 框架 SQLite 不保证）。
--
-- 搬移只点名**十四个历史列**（第 6 版的形状），两个新列一律置 NULL = 「还没听宿主说过」——
-- 不是 false：把"不知道"写成"可见"正是要把存量脏行留在界面上的那种错（父稿的降级铁律）。
--
-- 谁真的会跑它：Android（AndroidSqliteDriver）与 iOS（NativeSqliteDriver）由驱动做版本检查并逐级
-- migrate；桌面（DatabaseDriverFactory.jvm.kt）走建表/迁移/盖三步。没有这个文件的老库少两列，
-- 而 `selectAllAgentSessions` 是 `SELECT *`、生成的映射按列名取值 —— 症状是打开库那一刻
-- `no such column: origin`。

-- (1) 补建：按**第 6 版的形状**（含 host_updated_at、不含新两列）建出来；已经有的库是 no-op。
CREATE TABLE IF NOT EXISTS AgentSessionEntity (
    node_id TEXT NOT NULL,
    session_id TEXT NOT NULL,
    alias TEXT,
    agent_kind TEXT,
    state TEXT,
    title TEXT,
    started_at INTEGER,
    updated_at INTEGER NOT NULL,
    announced INTEGER NOT NULL,
    agent_id TEXT,
    ws_id TEXT,
    ws_title TEXT,
    ws_path TEXT,
    host_updated_at INTEGER,
    PRIMARY KEY (node_id, session_id)
);

-- (2) 幂等重建：新形状 = 十四个历史列 + 两个可空新列（与 RelayDatabase.sq 的 CREATE 逐列一致）。
CREATE TABLE AgentSessionEntity_new (
    node_id TEXT NOT NULL,
    session_id TEXT NOT NULL,
    alias TEXT,
    agent_kind TEXT,
    state TEXT,
    title TEXT,
    started_at INTEGER,
    updated_at INTEGER NOT NULL,
    announced INTEGER NOT NULL,
    agent_id TEXT,
    ws_id TEXT,
    ws_title TEXT,
    ws_path TEXT,
    host_updated_at INTEGER,
    origin TEXT,
    blank INTEGER,
    PRIMARY KEY (node_id, session_id)
);

INSERT INTO AgentSessionEntity_new (
    node_id, session_id, alias, agent_kind, state, title, started_at, updated_at, announced,
    agent_id, ws_id, ws_title, ws_path, host_updated_at
)
SELECT node_id, session_id, alias, agent_kind, state, title, started_at, updated_at, announced,
    agent_id, ws_id, ws_title, ws_path, host_updated_at
FROM AgentSessionEntity;

DROP INDEX IF EXISTS idx_agent_session_node;
DROP TABLE AgentSessionEntity;
ALTER TABLE AgentSessionEntity_new RENAME TO AgentSessionEntity;

CREATE INDEX IF NOT EXISTS idx_agent_session_node ON AgentSessionEntity(node_id);
