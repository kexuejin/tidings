-- 消息游标：分页与增量写的唯一排序依据。
--
-- ## 为什么不能继续用 timestamp 当游标
--
-- 同一毫秒可能有多条消息（agent 流式回复尤其如此：真机上 172 KB 那几条都在同一秒内）。
-- 用 `timestamp < ?` 做游标，同毫秒那几条要么被重复返回、要么整批漏掉 ——
-- 分页的正确性直接崩掉。`seq` 在会话内单调递增，游标天然无重无漏。
--
-- ## 为什么这列必须回填而不是留 NULL
--
-- 老库里 6656 条消息没有 seq。留 NULL 的话，`WHERE seq < ?` 会把这些行全部排除：
-- 分页一旦上线，**用户的历史直接看不见**（不是变慢，是消失）。
-- 按 (timestamp, id) 排序回填，让「同一毫秒内」也有确定的先后。
--
-- ## 为什么不用 CTE + UPDATE ... FROM
--
-- 实测在 sqlite-jdbc 上抛 `no such column: rn`：`UPDATE ... FROM` 里那个 CTE 的
-- 列名不能被外层直接引用。改用「子查询取 rowid 映射、再按 rowid 更新」，两种 SQLite
-- 版本都认，也不依赖 3.33+ 的 FROM 子句。
ALTER TABLE MessageEntity ADD COLUMN seq INTEGER;

-- 回填：每个会话内按 (timestamp, id) 编号，从 1 起。
--
-- id 也进排序键：同一毫秒的两条只有 id 不同，没有它编号顺序不稳定，
-- 两次迁移（或迁移与建索引之间）可能给出不同结果。
UPDATE MessageEntity
SET seq = (
    SELECT COUNT(*)
    FROM MessageEntity AS prior
    WHERE prior.conv_id = MessageEntity.conv_id
      AND (
          prior.timestamp < MessageEntity.timestamp
          OR (prior.timestamp = MessageEntity.timestamp AND prior.id <= MessageEntity.id)
      )
);

-- 会话内 seq 必须唯一：分页靠它做游标，重复会让「向上翻」跳过或重复消息。
-- UNIQUE 也顺手给出 (conv_id, seq) 的复合索引 —— 游标查询全部走它。
CREATE UNIQUE INDEX IF NOT EXISTS message_conv_seq
    ON MessageEntity(conv_id, seq);
