-- 授权细化到工作区与读写级别：AgentGrantEntity 获得 `ws_id` 与 `access` 两列。
-- PRIMARY KEY 升级为 (node_id, agent_key, ws_id)。

-- (1) 补建：按第 8 版的形状（不含 ws_id, access）建出来；已经有的库是 no-op。
CREATE TABLE IF NOT EXISTS AgentGrantEntity (
    node_id TEXT NOT NULL,
    agent_key TEXT NOT NULL DEFAULT '',
    scope TEXT NOT NULL,
    state TEXT NOT NULL,
    at INTEGER NOT NULL,
    PRIMARY KEY (node_id, agent_key)
);

-- (2) 幂等重建：新形状 = 五个历史列 + 两个带默认值的新列（与 RelayDatabase.sq 的 CREATE 逐列一致）。
CREATE TABLE AgentGrantEntity_new (
    node_id TEXT NOT NULL,
    agent_key TEXT NOT NULL DEFAULT '',
    scope TEXT NOT NULL,
    state TEXT NOT NULL,
    at INTEGER NOT NULL,
    ws_id TEXT NOT NULL DEFAULT '',
    access TEXT NOT NULL DEFAULT 'rw',
    PRIMARY KEY (node_id, agent_key, ws_id)
);

INSERT INTO AgentGrantEntity_new (
    node_id, agent_key, scope, state, at, ws_id, access
)
SELECT node_id, agent_key, scope, state, at, '', 'rw'
FROM AgentGrantEntity;

DROP TABLE AgentGrantEntity;
ALTER TABLE AgentGrantEntity_new RENAME TO AgentGrantEntity;
